# ==============================================================================
# Variables de Entorno - QuantBet AI Platform
# ==============================================================================

# Puerto expuesto en el host para acceder a la aplicación completa (Frontend + API)
APP_PORT=8080

# Credenciales de PostgreSQL
POSTGRES_USER=quiniela_user
POSTGRES_PASSWORD=cambia_esta_contrasena_segura_123
POSTGRES_DB=quiniela_db

# Inicialización automática de datos semilla (True para crear jornada 32 y predicciones en primer arranque)
AUTO_SEED=true

# Modo de ejecución de Node
NODE_ENV=production
